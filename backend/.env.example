APP_NAME="Bijuli Charge API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite works out of the box for local dev. Docker Compose switches this to MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ev_charge
# DB_USERNAME=ev
# DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail: "log" writes OTP emails to storage/logs/laravel.log. Use smtp in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bijuli-charge.test"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend origin (CORS + social-login redirect)
FRONTEND_URL=http://localhost:3000

# API token lifetime in minutes (default 7 days)
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Local only: include the OTP in API responses so you can sign up without a mail server.
# Ignored unless APP_ENV is local or testing.
EXPOSE_OTP_IN_RESPONSE=true

# Optional: Google / Facebook sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# Payments (sandbox only). "none" keeps online payment switched off.
# Khalti sandbox: https://docs.khalti.com   eSewa sandbox: https://developer.esewa.com.np
PAYMENTS_DRIVER=none
KHALTI_SECRET_KEY=
ESEWA_SECRET_KEY=
