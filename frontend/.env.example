NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL (robots.txt / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles. Defaults to the public OpenStreetMap server, which is not for production traffic.
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_TILE_ATTRIBUTION=

# Show one-click demo logins on the sign-in page (development only)
# NEXT_PUBLIC_DEMO_LOGIN=true
